.container {
  position: relative;
  width: 100%;
  height: 100vh;
}

.map {
  width: 100%;
  height: 100vh;
}

.bottom-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.1);
  max-height: 50vh;
  transition: max-height 0.3s ease;
  z-index: 100;
  display: flex;
  flex-direction: column;
}

.bottom-panel.expanded {
  max-height: 80vh;
}

.panel-handle {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 8rpx;
}

.handle-bar {
  width: 80rpx;
  height: 8rpx;
  background: #ddd;
  border-radius: 4rpx;
}

.panel-header {
  display: flex;
  align-items: center;
  padding: 8rpx 24rpx 16rpx;
  gap: 16rpx;
}

.city-search-wrap {
  flex: 1;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
}

.city-search-input {
  font-size: 28rpx;
  width: 100%;
}

.settings-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.hot-cities {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx 16rpx;
  gap: 12rpx;
}

.hot-city-btn {
  padding: 8rpx 24rpx;
  background: #f0f4ff;
  color: #2563eb;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.hot-city-btn.active {
  background: #2563eb;
  color: #fff;
}

.city-dropdown {
  max-height: 300rpx;
  overflow-y: auto;
  padding: 0 24rpx;
}

.city-dropdown-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.current-city-tag {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #666;
}

.attractions-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-top: 1rpx solid #f0f0f0;
}

.route-btn {
  background: #2563eb;
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: normal;
}

.attractions-list {
  flex: 1;
  max-height: 400rpx;
  padding: 0 24rpx;
}

.attraction-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.attraction-item.selected {
  background: #f0f4ff;
  margin: 0 -24rpx;
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
}

.attraction-check {
  margin-right: 16rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 6rpx;
}

.checkbox.checked {
  background: #2563eb;
  border-color: #2563eb;
}

.attraction-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.attraction-name {
  font-size: 28rpx;
  flex: 1;
}

.attraction-rating {
  font-size: 24rpx;
  color: #f59e0b;
  margin-left: 12rpx;
}

.route-info {
  padding: 16rpx 24rpx;
  background: #f0f4ff;
  font-size: 24rpx;
  color: #2563eb;
  text-align: center;
}

.route-panel {
  border-top: 1rpx solid #f0f0f0;
}

.mode-tabs {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #fafafa;
}

.mode-tab {
  flex: 1;
  padding: 12rpx 0;
  text-align: center;
  background: #fff;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666;
}

.mode-tab.active {
  background: #2563eb;
  color: #fff;
  border-color: #2563eb;
}

.route-details {
  padding: 16rpx 24rpx;
  max-height: 200rpx;
  overflow-y: auto;
}

.route-detail-item {
  padding: 8rpx 0;
  font-size: 24rpx;
  color: #666;
  border-bottom: 1rpx solid #f5f5f5;
}

.route-detail-item:last-child {
  border-bottom: none;
}

.settings-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
}

.settings-dialog {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  z-index: 201;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.dialog-field {
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.field-input {
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  width: 100%;
}

.field-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.dialog-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.dialog-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.dialog-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.dialog-btn.confirm {
  background: #2563eb;
  color: #fff;
}
